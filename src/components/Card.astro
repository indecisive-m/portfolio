---
import "../styles/global.css";

interface Props {
  title: string;
  href: string | undefined;
  description: string;
  tags: Array<string>;
  publishDate: Date;
}

const { href, title, description, tags, publishDate } = Astro.props;
---

<li>
  <article>
    <a href={href}>
      <h2>
        {title}
      </h2>
    </a>
    <p>{description}</p>
    <div class="tag-wrapper">
      <p class="small">
        {publishDate.toDateString().split(" ").slice(1).join(" ")}
      </p>
      <div class="flex">
        {tags.map((item) => <p class="small">{item}</p>)}
      </div>
    </div>
  </article>
</li>

<style>
  li {
    list-style: none;
    background-color: var(--container-color);
    border: 2px solid hsl(from var(--heading-color) h s l a 0.5);
    padding: 1rem;
    border-radius: 0.25rem;

    .small {
      font-size: 0.75rem;
    }

    a:link {
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline 2px;
      text-underline-offset: 0.5em;
    }

    &:has(a:hover) {
      scale: 1.01;
    }
    .flex {
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
    }
  }

  .tag-wrapper {
    display: flex;
    justify-content: space-between;
  }

  @container (max-width: 70ch) {
    .tag-wrapper {
      display: grid;
    }
  }
</style>
