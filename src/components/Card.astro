---
import "../styles/global.css";

interface Props {
  title: string;
  href: string | undefined;
  description: string;
  tags: Array<string>;
  publishDate: Date;
}

const { href, title, description, tags, publishDate } = Astro.props;
---

<li>
  <article>
    <div>
      <a href={href}>
        <h2>
          {title}
        </h2>
      </a>
      <p>{description}</p>
    </div>

    <div class="tag-wrapper">
      <p class="small">
        {publishDate.toDateString().split(" ").slice(1).join(" ")}
      </p>
      <div class="flex">
        {tags.map((item) => <p class="small">{item}</p>)}
      </div>
    </div>
  </article>
</li>

<style>
  li {
    list-style: none;
    background-color: var(--container-color);
    border: 1px solid hsl(from var(--font-color) h s l / 0.2);
    /*box-shadow: 0.5rem 6px hsl(from var(--font-color) h s l / 0.1);*/
    box-shadow: 0.5rem 6px var(--card-box-shadow);

    padding: 1rem;
    border-radius: 0.25rem;
    place-content: space-between;

    .small {
      font-size: 0.75rem;
    }

    a:link {
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline 2px;
      text-underline-offset: 0.5em;
    }

    &:has(a:hover) {
      scale: 1.01;
    }
    .flex {
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
    }
  }

  .tag-wrapper {
    display: flex;
    justify-content: space-between;
  }

  @container (max-width: 70ch) {
    .tag-wrapper {
      display: grid;
    }
  }
</style>
