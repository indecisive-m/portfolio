---
import "../styles/global.css";

interface Props {
  title: string;
  href: string | undefined;
  description: string;
  tags: Array<string>;
  publishDate: Date;
}

const { href, title, description, tags, publishDate } = Astro.props;
---

<li>
  <article>
    <a href={href}>
      <h2 transition:name={title} transition:persist>
        {title}
      </h2>
    </a>
    <p>{description}</p>
    <div class="flex">
      <p class="small">
        {publishDate.toDateString().split(" ").slice(1).join(" ")}
      </p>
      <div class="flex">
        {tags.map((item) => <p class="small tag-item">{item}</p>)}
      </div>
    </div>
  </article>
</li>

<style>
  li {
    list-style: none;
    background-color: var(--container-color);
    padding: 1rem;
    border-radius: 0.25rem;

    .small {
      font-size: 0.75rem;
    }

    a:link {
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    &:has(a:hover) {
      scale: 1.02;
    }
    .flex {
      display: flex;
      justify-content: space-between;
    }

    .tag-item {
      margin-inline: 0.5rem;
    }
  }
</style>
