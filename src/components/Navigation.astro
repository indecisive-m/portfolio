---
import "../styles/global.css";
import ThemeIcon from "./ThemeIcon.astro";

const { currentPage } = Astro.props;
---

<header>
  <button
    popovertarget="mobile-nav"
    aria-controls="mobile-nav"
    aria-expanded="false"
    id="menu-button"
  >
    <span class="visually-hidden">Menu</span>

    <svg
      class="icon-hamburger"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="4.5 7.5 15 9"
    >
      <path
        d="M5 8H13.75M5 12H19M10.25 16L19 16"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>

  <nav id="mobile-nav" popover>
    <ul>
      <li>
        <a
          href="/contact/"
          class:list={{ contact: currentPage === "Contact Me" }}
          >Contact Me
        </a>
      </li>
      <li>
        <a href="/" class:list={{ current: currentPage === "Home" }}>Home</a>
      </li>
      <li>
        <a href="/#about" class:list={{ current: currentPage === "About" }}>
          About
        </a>
      </li>
      <li>
        <a
          href="/#projects"
          class:list={{ current: currentPage === "Projects" }}
        >
          Projects
        </a>
      </li>
      <li>
        <a href="/blog/" class:list={{ current: currentPage === "Blog" }}
          >Blog</a
        >
      </li>

      {
        /* <a href="/tags/" class:list={{ current: currentPage === "Tag Index" }}>
          Tags
        </a> */
      }
      <li>
        <a
          href="/contact"
          class:list={{ current: currentPage === "Contact Me" }}
          >Contact Me
        </a>
      </li>
    </ul>
  </nav>
  <nav id="primary-nav">
    <ul>
      <li>
        <a
          href="/contact/"
          class:list={{ contact: currentPage === "Contact Me" }}
          >Contact Me
        </a>
      </li>
      <li>
        <a href="/" class:list={{ current: currentPage === "Home" }}>Home</a>
      </li>
      <li>
        <a href="/#about" class:list={{ current: currentPage === "About" }}>
          About
        </a>
      </li>
      <li>
        <a
          href="/#projects"
          class:list={{ current: currentPage === "Projects" }}
        >
          Projects
        </a>
      </li>
      <li>
        <a href="/blog/" class:list={{ current: currentPage === "Blog" }}
          >Blog</a
        >
      </li>

      {
        /* <a href="/tags/" class:list={{ current: currentPage === "Tag Index" }}>
          Tags
        </a> */
      }
      <li>
        <a
          href="/contact"
          class:list={{ current: currentPage === "Contact Me" }}
          >Contact Me
        </a>
      </li>
    </ul>
  </nav>
  <ThemeIcon />
</header>

<style>
  header {
    display: flex;
    height: 3rem;
    justify-content: space-between;
    align-items: center;
  }
  nav {
    width: 100%;
    margin: 0;
    align-items: center;
    margin-inline-end: 1.5rem;
  }

  ul {
    list-style: none;
    display: flex;
    justify-content: end;
    align-items: center;
    width: 100%;
    padding: 0;
    gap: 1.5rem;
  }

  ul > li:first-child {
    margin-right: auto;
    color: var(--bg-color);
    font-family: inherit;
    background: linear-gradient(
      0.25turn,
      var(--heading-color),
      var(--font-color)
    );
    background-clip: text;

    & > a {
      color: transparent;
      padding: 0.25rem 0.5rem;
      cursor: pointer;

      &:hover {
        color: var(--heading-color);
        text-decoration: wavy underline 2px;
        text-underline-offset: 0.5em;
      }
    }
  }

  ul > li:last-child {
    display: none;
  }

  a {
    &:hover {
      text-decoration: wavy underline 2px;
      text-underline-offset: 0.5em;
    }
    &:link:not(:hover, .current) {
      text-decoration: none;
    }
  }

  .current {
    color: var(--heading-color);
    text-decoration: underline;
    text-underline-offset: 0.5em;
  }

  .contact {
    display: none;
  }
  button {
    background-color: transparent;
    border: none;
    display: none;
    height: 3rem;
    width: 3rem;

    svg {
      --size: 2rem;
      height: var(--size);
      width: var(--size);
      fill: var(--font-color);
    }

    path {
      stroke: var(--font-color);
    }
  }

  @media (width >= 750px) {
    #mobile-nav {
      display: none;
    }
  }

  @media (width < 750px) {
    nav {
      display: none;
    }

    button {
      display: flex;
      cursor: pointer;
      justify-content: center;
      align-items: center;
    }

    .icon-close {
      display: none;
    }

    [aria-expanded="true"] {
      .icon-hamburger {
        display: none;
      }
    }

    nav:popover-open {
      display: flex;
      flex-direction: column;
      background-color: var(--bg-color);
      padding-inline: 2rem;
      padding-block-start: 4rem;
      padding-block-end: 10rem;
      justify-content: start;
      width: 40%;
      gap: 2rem;
      border: none;
      animation: open-mobile-nav 250ms ease-in-out forwards;

      &::backdrop {
        background-color: hsl(from var(--container-color) h s l / 0.4);
      }
      ul {
        flex-direction: column;
        gap: 1rem;
        align-items: start;
      }
      ul > li:first-child {
        display: none;
      }

      ul > li:last-child {
        display: inline-block;
      }
    }

    [aria-expanded="closing"] + nav {
      display: flex;
      flex-direction: column;
      position: absolute;
      padding-block: 6rem;
      padding-inline: 3rem;
      top: 0;
      left: 0;
      bottom: 0;
      background-color: var(--bg-color);
      width: 80%;
      gap: 2rem;
      z-index: 9;
      box-shadow: 0 0 0 100vmax hsl(from var(--bg-color) h s l / 0.6);
      animation: close-mobile-nav 500ms ease-in-out forwards;
    }
  }

  @media (width <= 400px) {
    nav:popover-open {
      width: 60%;
    }
  }
  @keyframes open-mobile-nav {
    0% {
      opacity: 0;
      translate: -1000px;
    }

    100% {
      opacity: 1;
      translate: 0px;
    }
  }

  @keyframes close-mobile-nav {
    100% {
      opacity: 0;
      translate: -1000px;
    }
  }
</style>

<script>
  const popover = document.getElementById("mobile-nav");
  const about = document.querySelector('a[href="/#about"]');
  const projects = document.querySelector('a[href="/#projects"]');

  about?.addEventListener("click", () => {
    popover?.hidePopover();
  });
  projects?.addEventListener("click", () => {
    popover?.hidePopover();
  });
