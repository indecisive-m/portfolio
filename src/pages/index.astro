---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

import myPhoto from "../assets/images/me.jpg";
import meWalking from "../assets/images/meWalking.jpg";

const pageTitle = "Home";
---

<Layout title={pageTitle}>
  <section class="hero-wrapper">
    <div class="img-wrapper">
      <Image
        src={myPhoto}
        alt="A photo of myself sat coding at a table overlooking the sea"
        height={1000}
        class="hero-img"
      />
    </div>

    <div class="text-wrapper">
      <h1>Mike Watkins</h1>
      <p class="subtitle">Mobile Developer</p>
      <!-- <a href="/contact">
        <button class="cta-button"><span>Contact Me</span></button>
      </a> -->
    </div>
  </section>
  <section class="about-wrapper" id="about">
    <div class="description-wrapper">
      <h2>Hey, I'm Mike</h2>
      <p>
        I am a mobile developer specialising in Android and React Native with a
        focus on building high-quality, cross-platform mobile applications.
      </p>
      <p>
        I live in Somerset, UK with my lovely wife Jessica and my black labrador
        Ruby.
      </p>
    </div>
    <div class="about-img-wrapper">
      <Image src={meWalking} alt="" class="img" />
      <p class="img-caption">I have a fascination with these pylons</p>
    </div>
    <div class="description-wrapper wide">
      <h2>Hey, I'm Mike</h2>
      <p>
        I am a mobile developer specialising in Android and React Native with a
        focus on building high-quality, cross-platform mobile applications.
      </p>
      <p>
        I live in Somerset, UK with my lovely wife Jessica and my black labrador
        Ruby.
      </p>
    </div>
  </section>

  <!-- <div>


    </div> -->
  <!-- <div class="img-wrapper">
      <Image
        src={myPhoto}
        alt="A photo of myself sat coding at a table overlooking the sea"
        height={400}
        class="img"
      />
    </div> -->

  <style>
    body {
      overflow-x: hidden;
    }

    .hero-wrapper {
      display: flex;
      height: calc(100vh - 5rem);
      flex-direction: column;
      padding-block-end: 5rem;
      position: relative;
      justify-content: end;
    }

    .text-wrapper {
      display: grid;
      width: 100%;
      margin: 0;
      padding: 0;
    }

    h1 {
      font-family: var(--font-sekuya);
      font-size: 10vw;
      padding: 0;
      margin: 0;
    }

    .subtitle {
      margin: 0;
      padding: 0;
      font-size: 4vw;
      font-family: var(--font-barlow);
    }

    .about-wrapper {
      height: calc(100vh - 5rem);
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      padding-block: 2rem;
      place-content: center;
      gap: 2rem;
    }

    .description-wrapper {
      background-color: var(--container-color);
      padding: 1rem;
      border: 1px solid hsl(from var(--font-color) h s l / 0.2);
      box-shadow: 1rem 8px hsl(from var(--heading-color) h s l / 0.2);
    }

    .img-wrapper {
      position: absolute;
      bottom: 0;
      right: -20rem;
      z-index: -1;
      transform: skew(1rem);
    }

    .hero-img {
      display: block;
      position: relative;
      aspect-ratio: 1/1;
      width: 100%;
      opacity: 15%;
    }
    .img-caption {
      display: none;
    }

    .img {
      display: block;
      aspect-ratio: 3 / 4;
      max-width: 100%;
      object-fit: contain;
      height: auto;
      box-shadow: 1rem 8px hsl(from var(--heading-color) h s l / 0.2);
    }

    .about-img-wrapper {
      position: relative;
    }

    .about-img-wrapper:hover .img-caption {
      position: absolute;
      bottom: -4rem;
      display: block;
    }

    .button {
      /*animation-name: fade-in;
    animation-duration: 1.25s;
    animation-delay: 1.5s;
    animation-fill-mode: forwards;
    opacity: 0%;*/
      background-color: var(--heading-color);
      color: var(--bg-color);
      font-family: inherit;
      border: none;
      border-radius: 5px;
      padding: 1rem 2rem;
      cursor: pointer;
    }

    @container (max-width: 70ch) {
      .grid {
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      .hero-img {
        display: none;
      }

      .hero-wrapper {
        place-content: center;
      }

      .text-wrapper {
        display: grid;
        width: 100%;
        margin: 0;
        padding: 0;
      }

      h1 {
        font-family: var(--font-sekuya);
        font-size: 4rem;
        padding: 0;
        margin: 0;
      }
      .subtitle {
        margin: 0;
        padding: 0;
        font-size: 1.5rem;
        font-family: var(--font-barlow);
      }
    }

    @container (width < 90ch) {
      .about-wrapper {
        grid-template-columns: 1fr 1fr;
      }

      .wide {
        grid-column: 1/-1;
      }
    }

    @container (max-width: 55ch) {
      .about-wrapper {
        grid-template-columns: 1fr;
        height: auto;
      }

      .img {
      }
    }
  </style>
</Layout>
