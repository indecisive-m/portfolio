---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

import myPhoto from "../assets/images/me.jpg";

const pageTitle = "Home";
---

<Layout title={pageTitle}>
  <div class="grid">
    <div>
      <div class="title-wrapper">
        <h1 class="hey">Hey,</h1>
        <h1 class="text">I'm Mike</h1>
      </div>
      <p class="paragraph">
        I am a mobile developer specialising in Android and React Native with a
        focus on building high-quality, cross-platform mobile applications.
      </p>
      <a href="/contact">
        <button class="button cta-button"><span>Contact Me</span></button>
      </a>
    </div>
    <div class="img-wrapper">
      <Image
        src={myPhoto}
        alt="A photo of myself sat coding at a table overlooking the sea"
        height={400}
        class="img"
      />
    </div>
  </div>
</Layout>
<style>
  .grid {
    display: grid;
    width: 100%;
    grid-template-columns: 1fr minmax(200px, 400px);
    justify-content: center;
    align-items: center;
    padding-block: 8rem;
    gap: 1rem;
  }

  p {
    margin: 0;
    margin-block-end: 4rem;
  }

  .paragraph {
    animation-name: fade-in;
    animation-duration: 1.25s;
    animation-delay: 1.5s;
    animation-fill-mode: forwards;
    opacity: 0%;
  }

  .img-wrapper {
    position: relative;

    &::after {
      content: "";
      position: absolute;
      border-radius: 100%;
      inset: -0.5rem;
      z-index: 1;
      box-shadow: -10px -10px 100px 50px
        light-dark(var(--light-bg-color), var(--dark-bg-color)) inset;
    }
  }

  .img {
    display: block;
    position: relative;
    aspect-ratio: 1/1;
    width: 100%;
    border-radius: 100%;
  }

  .title-wrapper {
    display: flex;
    gap: 1ch;
    background: linear-gradient(
      0.25turn,
      light-dark(var(--light-heading-color), var(--dark-heading-color)),
      lightblue,
      blue
    );
    background-clip: text;
    width: fit-content;
  }

  .hey {
    animation-name: flip;
    animation-duration: 1s;
    animation-fill-mode: forwards;
    opacity: 0%;
    transform: rotateX(-0.5turn) translateY(-100%) scaleY(0);
    color: transparent;
  }

  .text {
    animation-name: flip;
    animation-duration: 1s;
    animation-delay: 0.5s;
    animation-fill-mode: forwards;
    opactity: 0%;
    transform: rotateX(-0.5turn) translateY(-100%) scaleY(0);
    color: transparent;
  }

  .button {
    animation-name: fade-in;
    animation-duration: 1.25s;
    animation-delay: 1.5s;
    animation-fill-mode: forwards;
    opacity: 0%;
    background-color: light-dark(
      var(--light-heading-color),
      var(--dark-heading-color)
    );
    color: light-dark(var(--light-bg-color), var(--dark-bg-color));
    font-family: inherit;
    border: none;
    border-radius: 5px;
    padding: 1rem 2rem;
    cursor: pointer;
  }

  @keyframes flip {
    50% {
      transform: rotateX(-0.5turn) translateY(-50%) scaleY(0%);
      opacity: 10%;
    }

    75% {
      opacity: 20%;
    }
    100% {
      transform: rotateX(-1turn) translateY(0%) scaleY(100%);
      opacity: 100%;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0%;
    }

    to {
      opacity: 100%;
    }
  }

  @container (max-width: 70ch) {
    .grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .img {
      display: none;
    }
  }
</style>
