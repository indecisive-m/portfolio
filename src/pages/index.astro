---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

import myPhoto from "../assets/images/me.jpg";
import meWalking from "../assets/images/meWalking.jpg";
import HomePage from "../assets/images/Home_Page.png";

const pageTitle = "Home";
---

<Layout title={pageTitle}>
	<main>
    <section class="hero-wrapper">
    	<div class="img-wrapper">
     		<Image
          src={myPhoto}
          alt="A photo of myself sat coding at a table overlooking the sea"
          height={1000}
          class="hero-img"
        />
      </div>
      <div class="text-wrapper">
        <h1>Mike Watkins</h1>
        <p class="subtitle">Mobile Developer</p>
      </div>
    </section>
	</main>

  <section class="about-wrapper" id="about">
    <div class="about-img-wrapper">
      <Image src={meWalking} alt="An image of myself walking away from the photographer. I am walking my dog in a field of dead grass. There are trees infront of me and off to the right is a large electricity pylon " class="img" />
      <p class="img-caption">I'm fascinated with these pylons</p>
    </div>
    <div class="description-wrapper">
      <h2>Hey, I'm Mike</h2>
      <p class="description-text">
        I am a mobile developer specialising in Android and React Native with a
        focus on building high-quality, cross-platform mobile applications.
      </p>
      <p class="description-text">
        I live in Somerset, UK with my lovely wife Jessica and my black labrador
        Ruby.
      </p>
      <p>I enjoy DIY and building things out of wood. Going on walks and adventures with the dog, we especially like the woods. I also like relaxing with a cup of tea and a good puzzle.</p>
    </div>
  </section>

  <section id="projects" class="projects-wrapper">
  	<h2>Projects</h2>
   <div class="project-card">
   <div class="project-image-wrapper">
   	<Image src={HomePage} alt="" class="project-image"/>
   </div>
    <div>
    	<h3>Movie Search <span>(working title)</span></h3>
     	<p>Movie Search is an android app built with Jetpack Compose which heavily utilises the TMDB api to search for movies and tv shows. It has a details screen with headline and genre categories as well as watch providers, cast details, recommendations and reviews. There is a watch later screen which gets details from Room storage for offline support for saved media.
      </p>
      <br/>
      <br/>
      <span class="development-state">Active</span>
    </div>

   </div>
   <div class="project-card">
    <div>
    	<h3>Portfolio Site</h3>
     	<p>
      The website you're currently on, my portfolio site. Currently on V2 after a design revamp due to a year or so of non use. Built with Typescript in Astro. Using Resend for the contact form and cloudflare turnstile for bot prevention.
      </p>
      <br/>
      <br/>
      <span class="development-state">Active</span>
    </div>
   </div>
  </section>


  <style>
    body {
      overflow-x: hidden;
    }

    .hero-wrapper {
      display: flex;
      height: calc(100vh - 5rem);
      flex-direction: column;
      padding-block-end: 5rem;
      position: relative;
      justify-content: end;
    }

    .text-wrapper {
      display: grid;
      width: 100%;
      margin: 0;
      padding: 0;
    }

    h1 {
      font-family: var(--font-sekuya);
      font-size: 10vw;
      padding: 0;
      margin: 0;
    }

    .subtitle {
      margin: 0;
      padding: 0;
      font-size: 4vw;
      font-family: var(--font-barlow);
    }

    h2 {
        font-size: 2vw;
    }



    .about-wrapper {
      height: calc(100vh - 5rem);
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(400px, 50%), 1fr));
      padding-block: 2rem;
      place-content: center;
      gap: 2rem;
      margin-block: 3rem;

      & h2 {
          font-size: 5rem;
          font-family: var(--font-sekuya);
      }
      & p {
          font-size: 1.25rem;
      }

      .img-caption {
          display: none;
          opacity: 0;
      }
    }

    .description-wrapper {
      background-color: var(--container-color);
      height: 100%;
      padding-inline: 2rem;
      align-content: center;
      line-height: 1.2;
      border: 1px solid hsl(from var(--font-color) h s l / 0.2);
      box-shadow: 1rem 8px hsl(from var(--heading-color) h s l / 0.2);
    }



    .img-wrapper {
      position: absolute;
      bottom: 0;
      right: -20rem;
      z-index: -1;
      transform: skew(1rem);
    }

    .hero-img {
      display: block;
      position: relative;
      aspect-ratio: 1/1;
      width: 100%;
      opacity: 15%;
    }


    .img {
      display: block;
      aspect-ratio: 3 / 4;
      max-width: 100%;
      object-fit: contain;
      height: auto;
      box-shadow: 1rem 8px hsl(from var(--heading-color) h s l / 0.2);
      border: 1px solid hsl(from var(--font-color) h s l / 0.2);
    }

    .about-img-wrapper {
      position: relative;
    }

    .about-img-wrapper:hover .img-caption {
      position: absolute;
      display: block;
      bottom: 0;
      padding-inline: 2rem;
      padding-block: 1.5rem;
      background-color: var(--container-color);
      border-radius: 0.5rem;
      width: 100%;
      color: var(--font-color);
      text-align: center;
      border: 1px solid hsl(from var(--font-color) h s l / 0.2);
      opacity: 1;

      transition-property: opacity, display;
      transition-duration: 0.5s;
      transition-behavior: allow-discrete;

      @starting-style {
        opacity: 0;
      }
     }
    }

    .button {
    	background-color: var(--heading-color);
      color: var(--bg-color);
      font-family: inherit;
      border: none;
      border-radius: 5px;
      padding: 1rem 2rem;
      cursor: pointer;
    }

    .projects-wrapper {
    	height: calc(100vh - 5rem);
     padding-block: 4rem;
     display: flex;
     flex-direction: column;
     gap: 2rem;

     & h2 {
       font-size: 8vw;
       font-family: var(--font-sekuya);
     }
      & h3 {
      	color: var(--heading-color)
      }

      & span {
      	color: var(--font-color);
       font-size: 1rem;
      }
    }

    .project-image-wrapper {
    	padding: 1rem;
    }

    .project-card {
    	display: flex;
     padding-inline: 1rem;
     	background-color: var(--container-color);
      border: 1px solid hsl(from var(--font-color) h s l / 0.2);
      box-shadow: 1rem 8px hsl(from var(--heading-color) h s l / 0.2);
      position: relative;

      & .development-state {
      position: absolute;
      bottom: 1rem;
      right: 1rem;
      color: var(--heading-color);
      font-size: 1.125rem;

      &::before {
      	content: "◦";
       padding-inline: 1ch;
      }
      }
    }

    .project-image {
    	display: block;
     	max-width: 100px;
      aspect-ratio: 9/20;
      height: auto;
      position: relative;
    }



    @container ( max-width: 95ch) {
      .about-wrapper {
        grid-template-columns: 1fr 1fr;
        height: auto;

        & h2 {
            font-size: 2rem;
        }
        & p {
            font-size: 1rem;
        }
      }


    }

    @container (max-width: 75ch) {
      .grid {
        grid-template-columns: 1fr;
        gap: 1rem;
      }
      .about-wrapper {
        grid-template-columns: 1fr;
        height: auto;

        & h2 {
            font-size: 2.25rem;
        }
        & p {
            font-size: 1.125rem;
        }
      }

      .description-wrapper {
          padding-block: 2rem;
          grid-row: 1;
      }


      .hero-img {
        opacity: 10%;
      }

      .hero-wrapper {
        place-content: center;
      }

      .text-wrapper {
        display: grid;
        width: 100%;
        margin: 0;
        padding: 0;
      }

      h1 {
        font-family: var(--font-sekuya);
        font-size: 4rem;
        padding: 0;
        margin: 0;
      }
      .subtitle {
        margin: 0;
        padding: 0;
        font-size: 1.5rem;
        font-family: var(--font-barlow);
      }

      .about-wrapper {
        grid-template-columns: 1fr;
      }



    }

    @container (max-width: 40ch) {
    .project-image-wrapper {
    	display: none;
    }

    .projects-wrapper {
    	margin-block-end: 5rem;
    }
    }



  </style>
</Layout>
